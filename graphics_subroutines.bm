sub draw_screen
	
	gset.tile_size = (gset.screen_resolution.y / 15) * gset.window_size
	gset.scale_multiplier = gset.tile_size / 32
	
	_source gdata.bg_tiles
	_dest gdata.bg_tiles
	cls , _rgba(0, 0, 0, 0)
	_source gdata.fg_tiles
	_dest gdata.fg_tiles
	cls , _rgba(0, 0, 0, 0)
	_source gdata.entity_layer
	_dest gdata.entity_layer
	cls , _rgba(0, 0, 0, 0)
	
	for i = 0 to gset.numberOfEntities
		draw_entity entities(i)
	next i
	
	_source gdata.ui
	_dest gdata.ui
	cls
	
	_source 0
	_dest 0
	cls
	
	draw_map
	
	_clearcolor _rgb(255, 64, 255), gdata.bg_tiles
	_clearcolor _rgb(255, 64, 255), gdata.entity_layer
	_clearcolor _rgb(255, 64, 255), gdata.fg_tiles
	
	_putimage (gset.window_offset.x, gset.window_offset.y), gdata.bg_tiles
	_putimage (gset.window_offset.x, gset.window_offset.y), gdata.entity_layer
	_putimage (gset.window_offset.x, gset.window_offset.y), gdata.fg_tiles
	'_putimage (0, 0), gdata.ui
	
	locate 1,1
	print entities(0).p.x, entities(0).p.y
	print "Keys: "; player_data.keys
	print "Entities: "; gset.numberOfEntities
	print gset.window_offset.x, gset.window_offset.y
	a = _mouseinput
	? _mousex, _mousey
	
	if gdata.show_hotpoints = 1 then
		for i = 0 to gset.numberOfEntities
			if entities(i).state <> 0 then
				cx = camera.x * (32)
				cy = camera.y * (32)
				tileSizeX = tile_map(0, 0).tile_end.x - tile_map(0, 0).tile_start.x
				tileSizeY = tile_map(0, 0).tile_end.y - tile_map(0, 0).tile_start.y
				ex = (entities(i).p.x - cx) * gset.scale_multiplier
				ey = (entities(i).p.y - cy) * gset.scale_multiplier
				
				etlx = (entities(i).tl.x - cx) * gset.scale_multiplier
				etly = (entities(i).tl.y - cy) * gset.scale_multiplier
				
				etrx = (entities(i).tr.x - cx) * gset.scale_multiplier
				etry = (entities(i).tr.y - cy) * gset.scale_multiplier
				
				eblx = (entities(i).bl.x - cx) * gset.scale_multiplier
				ebly = (entities(i).bl.y - cy) * gset.scale_multiplier
				
				ebrx = (entities(i).br.x - cx) * gset.scale_multiplier
				ebry = (entities(i).br.y - cy) * gset.scale_multiplier
				
				e1x = ex + entities(i).o.x * gset.scale_multiplier
				e1y = ey + entities(i).o.y * gset.scale_multiplier
				e2x = ex + (entities(i).o.x + entities(i).w) * gset.scale_multiplier
				e2y = ey + (entities(i).o.y + entities(i).h) * gset.scale_multiplier
				
					pset (ex, ey), _rgb(255, 255, 255)
					pset (etlx, etly), _rgb(255, 255, 255)
					pset (etrx, etry), _rgb(255, 255, 255)
					pset (eblx, ebly), _rgb(255, 255, 255)
					pset (ebrx, ebry), _rgb(255, 255, 255)
					circle ((entities(i).actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (entities(i).actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), 5 * gset.scale_multiplier, _rgb(255, 255, 255)
					pset ((entities(i).actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (entities(i).actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), _rgb(255, 255, 255)
					'line (10, 10)-(640, 100), _rgb(255,255,255), bf
				
			end if
		next i
	end if
end sub


sub draw_map

	for y = 0 to 14
		for x = 0 to 19
			
			newx = camera.x + x
			newy = camera.y + y
			
			'Check if the x and y values are within the array boundaries.
			if newx >= 0 and newx <= gset.world_size.x then
				if newy >= 0 and newy <= gset.world_size.y then
					
					tile_map(x, y).tile_start.x = x * gset.tile_size
					tile_map(x, y).tile_start.y = y * gset.tile_size
					tile_map(x, y).tile_end.x = x * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_end.y = y * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_index = map(newx, newy).tile_type
					
					select case map_tileset(map(newx, newy).tile_type).layer
						case 0:
							_source gdata.bg_tiles
							_dest gdata.bg_tiles
						case 1:
							_source gdata.fg_tiles
							_dest gdata.fg_tiles
					end select
					
					
					draw_tile tile_map(x, y)
					
					_source 0
					_dest 0
					
					
				end if
			end if
			
		next x
	next y
end sub

sub draw_tile (t as screen_tile)

	w = _width(map_tileset_gfx(map_tileset(t.tile_index).index_start))
	h = _height(map_tileset_gfx(map_tileset(t.tile_index).index_start))
	
	yoff = ((h / w) * gset.tile_size) - gset.tile_size

	drawx1 = t.tile_start.x
	drawy1 = t.tile_start.y - yoff
	drawx2 = t.tile_end.x
	drawy2 = t.tile_end.y
	
	bg_r = map_tileset(t.tile_index).bg_color.r
	bg_g = map_tileset(t.tile_index).bg_color.g
	bg_b = map_tileset(t.tile_index).bg_color.b
	
	r = map_tileset(t.tile_index).solid_color.r
	g = map_tileset(t.tile_index).solid_color.g
	b = map_tileset(t.tile_index).solid_color.b
	
	if map_tileset(t.tile_index).is_image = 0 then
		line (drawx1, drawy1)-(drawx2, drawy2), _rgb(bg_r, bg_g, bg_b), BF
		line (drawx1, drawy1)-(drawx2, drawy2), _rgb(r, g, b), BF
		'line (drawx1, drawy1)-(drawx2, drawy2), _rgb(0, 0, 0), B
	else
		_putimage(drawx1, drawy1)-(drawx2, drawy2), map_tileset_gfx(map_tileset(t.tile_index).bg_index)
		frame = int(map_tileset(t.tile_index).index_start + map_tileset(t.tile_index).frame_counter)
		_putimage(drawx1, drawy1)-(drawx2, drawy2), map_tileset_gfx(frame)
		'line (drawx1, drawy1)-(drawx2, drawy2), _rgba(r, g, b, 64), B
	end if
end sub

sub animate_tileset(t as _unsigned integer)
	map_tileset(t).frame_step = map_tileset(t).frame_step + 1
	if map_tileset(t).frame_step >= map_tileset(t).frame_threshold then
		map_tileset(t).frame_counter = map_tileset(t).frame_counter + 1
		map_tileset(t).frame_step = 0
	end if
	if int(map_tileset(t).frame_counter + map_tileset(t).index_start) > map_tileset(t).index_end then
		map_tileset(t).frame_counter = 0
		map_tileset(t).frame_step = 0
	end if
end sub

sub draw_entity (e as entity)
	dim frame as long
	if e.state <> 0 then
		cx = camera.x * (32)
		cy = camera.y * (32)
		tileSizeX = tile_map(0, 0).tile_end.x - tile_map(0, 0).tile_start.x
		tileSizeY = tile_map(0, 0).tile_end.y - tile_map(0, 0).tile_start.y
		ex = (e.p.x - cx) * gset.scale_multiplier
		ey = (e.p.y - cy) * gset.scale_multiplier
		
		etlx = (e.tl.x - cx) * gset.scale_multiplier
		etly = (e.tl.y - cy) * gset.scale_multiplier
		
		etrx = (e.tr.x - cx) * gset.scale_multiplier
		etry = (e.tr.y - cy) * gset.scale_multiplier
		
		eblx = (e.bl.x - cx) * gset.scale_multiplier
		ebly = (e.bl.y - cy) * gset.scale_multiplier
		
		ebrx = (e.br.x - cx) * gset.scale_multiplier
		ebry = (e.br.y - cy) * gset.scale_multiplier
		
		e1x = ex + e.o.x * gset.scale_multiplier
		e1y = ey + e.o.y * gset.scale_multiplier
		e2x = ex + (e.o.x + e.w) * gset.scale_multiplier
		e2y = ey + (e.o.y + e.h) * gset.scale_multiplier
		
		
		_dest gdata.entity_layer
		
		if e.is_image = 0 then
			line (etlx, etly)-(ebrx, ebry), _rgb(e.look.r, e.look.g, e.look.b), BF
		else
			frame = entity_sprites(e.index_start + e.frame_counter)
			if frame < 0 then frame = 0: if frame > 255 then frame = 255
			_putimage(etlx, etly)-(ebrx, ebry), entity_sprites(e.index_start)
		end if
		
		'if gdata.show_hotpoints = 1 then
		'	pset (ex, ey), _rgb(255, 255, 255)
		'	pset (etlx, etly), _rgb(255, 255, 255)
		'	pset (etrx, etry), _rgb(255, 255, 255)
		'	pset (eblx, ebly), _rgb(255, 255, 255)
		'	pset (ebrx, ebry), _rgb(255, 255, 255)
		'	circle ((e.actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (e.actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), 5 * gset.scale_multiplier, _rgb(255, 255, 255)
		'	pset ((e.actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (e.actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), _rgb(255, 255, 255)
		'end if
		
		_dest 0
		
	end if
end sub
