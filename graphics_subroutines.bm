sub draw_screen_gameplay
	
	gset.tile_size = (gset.screen_resolution.y / 15) * gset.window_size
	gset.scale_multiplier = gset.tile_size / 32
	
	_source gdata.bg_tiles
	_dest gdata.bg_tiles
	cls , _rgba(0, 0, 0, 0)
	_source gdata.fg_tiles
	_dest gdata.fg_tiles
	cls , _rgba(0, 0, 0, 0)
	_source gdata.entity_layer
	_dest gdata.entity_layer
	cls , _rgba(0, 0, 0, 0)
	_source gdata.entity_fg_layer
	_dest gdata.entity_fg_layer
	cls , _rgba(0, 0, 0, 0)
	
	
	if (int(player_data.dmg_cooldown / 1) mod 2) = 0 or player_data.dmg_cooldown = 0 then draw_entity entities(0)
	
	for i = 1 to 128 'gset.numberOfEntities
		draw_entity entities(i)
	next i
	
	
	draw_hotpoints
	
	
	_source 0
	_dest 0
	cls
	
	draw_map
	
	_clearcolor _rgb(255, 64, 255), gdata.bg_tiles
	_clearcolor _rgb(255, 64, 255), gdata.entity_layer
	_clearcolor _rgb(255, 64, 255), gdata.fg_tiles
	_clearcolor _rgb(255, 64, 255), gdata.entity_fg_layer
	_clearcolor _rgb(255, 64, 255), gdata.ui_bg
	_clearcolor _rgb(255, 64, 255), gdata.ui

	
	_putimage (gset.window_offset.x, gset.window_offset.y), gdata.bg_tiles
	_putimage (gset.window_offset.x, gset.window_offset.y), gdata.entity_layer
	_putimage (gset.window_offset.x, gset.window_offset.y), gdata.fg_tiles
	_putimage (gset.window_offset.x, gset.window_offset.y), gdata.entity_fg_layer
	_putimage (0, 0), gdata.ui_bg
	_putimage (0, 0), gdata.ui
	
	print "E:"; gset.numberOfEntities
	print player_data.dmg_cooldown
	
end sub

sub update_ui
	_source gdata.ui_bg
	_dest gdata.ui_bg
	_putimage (0, 0)-(799, 599), overlay_img
	_source gdata.ui
	_dest gdata.ui
	_printmode _keepbackground
	cls, _rgb(255, 64, 255)
	_putimage (64, 532 - 16), heart_img
	select case player_data.health
		case 0 to 2:
			color _rgb(255, 0, 0)
		case 3 to 7:
			color _rgb(255, 255, 0)
		case 8 to 10:
			color _rgb(0, 255, 0)
		case 11 to 15:
			color _rgb(0, 255, 255)
	end select
	_printstring (116, 550 - 16), "x " + str$(player_data.health)
	for i = 0 to 2
		if inventory(i).state = 0 then color _rgb(100, 100, 100) else color _rgb(0, 255, 0)
		_printstring (180 + (i * 192), 532), str$(i + 1) + ". " + str$(inventory(i).quantity) + "x " + inventory(i).item_name
		if inventory(i + 3).state = 0 then color _rgb(100, 100, 100) else color _rgb(0, 255, 0)
		_printstring (180 + (i * 192), 548), str$(i + 4) + ". " + str$(inventory(i + 3).quantity) + "x " + inventory(i + 3).item_name
		if inventory(i + 6).state = 0 then color _rgb(100, 100, 100) else color _rgb(0, 255, 0)
		_printstring (180 + (i * 192), 564), str$(i + 7) + ". " + str$(inventory(i + 6).quantity) + "x " + inventory(i + 6).item_name
	next i
	color _rgb(255, 255, 255)
	_printstring (72, 532 + 32), "Sword: lvl" + str$(player_data.sword_level)
end sub

sub draw_hotpoints
	_source gdata.entity_fg_layer
	_dest gdata.entity_fg_layer
	
	
	
	if gdata.show_hotpoints = 1 then
		for i = 0 to 128
			if entities(i).state <> 0 then
				cx = camera.x * (32)
				cy = camera.y * (32)
				'tileSizeX = tile_map(0, 0).tile_end.x - tile_map(0, 0).tile_start.x
				'tileSizeY = tile_map(0, 0).tile_end.y - tile_map(0, 0).tile_start.y
				ex = (entities(i).p.x - cx) * gset.scale_multiplier
				ey = (entities(i).p.y - cy) * gset.scale_multiplier
				
				etlx = (entities(i).tl.x - cx) * gset.scale_multiplier
				etly = (entities(i).tl.y - cy) * gset.scale_multiplier
				
				etrx = (entities(i).tr.x - cx) * gset.scale_multiplier
				etry = (entities(i).tr.y - cy) * gset.scale_multiplier
				
				eblx = (entities(i).bl.x - cx) * gset.scale_multiplier
				ebly = (entities(i).bl.y - cy) * gset.scale_multiplier
				
				ebrx = (entities(i).br.x - cx) * gset.scale_multiplier
				ebry = (entities(i).br.y - cy) * gset.scale_multiplier
				
				e1x = ex + entities(i).o.x * gset.scale_multiplier
				e1y = ey + entities(i).o.y * gset.scale_multiplier
				e2x = ex + (entities(i).o.x + entities(i).w) * gset.scale_multiplier
				e2y = ey + (entities(i).o.y + entities(i).h) * gset.scale_multiplier
				
					pset (ex, ey), _rgb(255, 255, 255)
					pset (etlx, etly), _rgb(255, 255, 255)
					pset (etrx, etry), _rgb(255, 255, 255)
					pset (eblx, ebly), _rgb(255, 255, 255)
					pset (ebrx, ebry), _rgb(255, 255, 255)
					circle ((entities(i).actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (entities(i).actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), 5 * gset.scale_multiplier, _rgb(255, 255, 255)
					pset ((entities(i).actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (entities(i).actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), _rgb(255, 255, 255)
					'line (10, 10)-(640, 100), _rgb(255,255,255), bf
				
				swhitboxx = (player_data.meleeboxtl.x - cx) * gset.scale_multiplier
				swhitboxy = (player_data.meleeboxtl.y - cy) * gset.scale_multiplier
				swhitboxx1 = (player_data.meleeboxbr.x - cx) * gset.scale_multiplier
				swhitboxy1 = (player_data.meleeboxbr.y - cy) * gset.scale_multiplier
				
				if i <> 0 and entity_test_zone(entities(i), player_data.meleeboxtl.x, player_data.meleeboxtl.y, player_data.meleeboxbr.x, player_data.meleeboxbr.y) = 1 then
					meleebox = 1
				end if
				
			end if
		next i
		
		if meleebox = 1 then
			line (swhitboxx, swhitboxy)-(swhitboxx1, swhitboxy1), _rgb(255, 0, 0), b
		else
			line (swhitboxx, swhitboxy)-(swhitboxx1, swhitboxy1), _rgb(255, 255, 0), b
		end if
		
	end if
end sub

sub draw_map

	for y = 0 to 14
		for x = 0 to 19
			
			newx = camera.x + x
			newy = camera.y + y
			
			'Check if the x and y values are within the array boundaries.
			if newx >= 0 and newx <= gset.world_size.x then
				if newy >= 0 and newy <= gset.world_size.y then
					
					tile_map(x, y).tile_start.x = x * gset.tile_size
					tile_map(x, y).tile_start.y = y * gset.tile_size
					tile_map(x, y).tile_end.x = x * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_end.y = y * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_index = map(newx, newy).tile_type
					
					select case map_tileset(map(newx, newy).tile_type).layer
						case 0:
							_source gdata.bg_tiles
							_dest gdata.bg_tiles
						case 1:
							_source gdata.fg_tiles
							_dest gdata.fg_tiles
					end select
					
					
					draw_tile tile_map(x, y)
					
					_source 0
					_dest 0
					
					
				end if
			end if
			
		next x
	next y
end sub

sub draw_tile (t as screen_tile)

	w = _width(map_tileset_gfx(map_tileset(t.tile_index).index_start))
	h = _height(map_tileset_gfx(map_tileset(t.tile_index).index_start))
	
	yoff = ((h / w) * gset.tile_size) - gset.tile_size

	drawx1 = t.tile_start.x
	drawy1 = t.tile_start.y - yoff
	drawx2 = t.tile_end.x
	drawy2 = t.tile_end.y
	
	bg_r = map_tileset(t.tile_index).bg_color.r
	bg_g = map_tileset(t.tile_index).bg_color.g
	bg_b = map_tileset(t.tile_index).bg_color.b
	
	r = map_tileset(t.tile_index).solid_color.r
	g = map_tileset(t.tile_index).solid_color.g
	b = map_tileset(t.tile_index).solid_color.b
	
	if map_tileset(t.tile_index).is_image = 0 then
		line (drawx1, drawy1)-(drawx2, drawy2), _rgb(bg_r, bg_g, bg_b), BF
		line (drawx1, drawy1)-(drawx2, drawy2), _rgb(r, g, b), BF
		'line (drawx1, drawy1)-(drawx2, drawy2), _rgb(0, 0, 0), B
	else
		_putimage(drawx1, drawy1)-(drawx2, drawy2), map_tileset_gfx(map_tileset(t.tile_index).bg_index)
		frame = int(map_tileset(t.tile_index).index_start + map_tileset(t.tile_index).frame_counter)
		_putimage(drawx1, drawy1)-(drawx2, drawy2), map_tileset_gfx(frame)
		'line (drawx1, drawy1)-(drawx2, drawy2), _rgba(r, g, b, 64), B
	end if
end sub

sub animate_tileset(t as _unsigned integer)
	map_tileset(t).frame_step = map_tileset(t).frame_step + 1
	if map_tileset(t).frame_step >= map_tileset(t).frame_threshold then
		map_tileset(t).frame_counter = map_tileset(t).frame_counter + 1
		map_tileset(t).frame_step = 0
	end if
	if int(map_tileset(t).frame_counter + map_tileset(t).index_start) > map_tileset(t).index_end then
		map_tileset(t).frame_counter = 0
		map_tileset(t).frame_step = 0
	end if
end sub

sub draw_entity (e as entity)
	dim frame as long
	if e.state <> 0 then
		cx = camera.x * (32)
		cy = camera.y * (32)
		tileSizeX = tile_map(0, 0).tile_end.x - tile_map(0, 0).tile_start.x
		tileSizeY = tile_map(0, 0).tile_end.y - tile_map(0, 0).tile_start.y
		ex = (e.p.x - cx) * gset.scale_multiplier
		ey = (e.p.y - cy) * gset.scale_multiplier
		
		etlx = (e.tl.x - cx) * gset.scale_multiplier
		etly = (e.tl.y - cy) * gset.scale_multiplier
		
		etrx = (e.tr.x - cx) * gset.scale_multiplier
		etry = (e.tr.y - cy) * gset.scale_multiplier
		
		eblx = (e.bl.x - cx) * gset.scale_multiplier
		ebly = (e.bl.y - cy) * gset.scale_multiplier
		
		ebrx = (e.br.x - cx) * gset.scale_multiplier
		ebry = (e.br.y - cy) * gset.scale_multiplier
		
		e1x = ex + e.o.x * gset.scale_multiplier
		e1y = ey + e.o.y * gset.scale_multiplier
		e2x = ex + (e.o.x + e.w) * gset.scale_multiplier
		e2y = ey + (e.o.y + e.h) * gset.scale_multiplier
		
		if e.layer = 0 then _dest gdata.entity_layer else _dest gdata.entity_fg_layer
		
		if e.is_image = 0 then
			line (etlx, etly)-(ebrx, ebry), _rgb(e.look.r, e.look.g, e.look.b), BF
		else
			frame = entity_sprites(e.index_start + e.frame_counter)
			if frame < 0 then frame = 0: if frame > 255 then frame = 255
			_clearcolor _rgb(255, 64, 255), entity_sprites(e.index_start)
			_putimage(etlx, etly)-(ebrx, ebry), entity_sprites(e.index_start)
		end if
		
		'if gdata.show_hotpoints = 1 then
		'	pset (ex, ey), _rgb(255, 255, 255)
		'	pset (etlx, etly), _rgb(255, 255, 255)
		'	pset (etrx, etry), _rgb(255, 255, 255)
		'	pset (eblx, ebly), _rgb(255, 255, 255)
		'	pset (ebrx, ebry), _rgb(255, 255, 255)
		'	circle ((e.actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (e.actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), 5 * gset.scale_multiplier, _rgb(255, 255, 255)
		'	pset ((e.actionPoint.x * gset.scale_multiplier) - (cx * gset.scale_multiplier), (e.actionPoint.y * gset.scale_multiplier) - (cy * gset.scale_multiplier)), _rgb(255, 255, 255)
		'end if
		
		_dest 0
		
	end if
end sub

sub draw_screen_chat
	x1 = gset.screen_resolution.x * 0.25
	x2 = gset.screen_resolution.x * 0.75
	y1 = gset.screen_resolution.y * 0.25
	y2 = gset.screen_resolution.y * 0.5
	line (x1, y1)-(x2, y2), _rgba(0, 0, 0, 127), bf
	row = 1
	col = 1
	for i = 0 to 255
		if mid$(chats(chat_system.active_chat).msg, i, 1) = "`" then 
			row = row + 1
			col = 1
		else
			_printstring (x1 + 8 * col, y1 + row * 16), mid$(chats(chat_system.active_chat).msg, i, 1)
			col = col + 1
		end if
	next i
	for i = 1 to 3
		'if _trim$(chats(chat_system.active_chat).reply.text) <> "" then
			line (x1, y2 + 8 + ((i - 1) * 64))-(x2, y2 + 64 + ((i - 1) * 64)), _rgba(0, 0, 0, 127), bf
			if i = 1 then _printstring (x1 + 1, y2 + 8 + ((i - 1) * 64) + 1), str$(i) + ". " + _trim$(chats(chat_system.active_chat).reply1.text)
			if i = 2 then _printstring (x1 + 1, y2 + 8 + ((i - 1) * 64) + 1), str$(i) + ". " + _trim$(chats(chat_system.active_chat).reply2.text)
			if i = 3 then _printstring (x1 + 1, y2 + 8 + ((i - 1) * 64) + 1), str$(i) + ". " + _trim$(chats(chat_system.active_chat).reply3.text)
		'end if
	next i
end sub

sub draw_screen_editor(mx as double, my as double)

	cx = int(mx) - camera.x
	cy = int(my) - camera.y
	
	color _rgba(255, 255, 255, 255)
	
	for y = 0 to 14
		for x = 0 to 19
			
			newx = camera.x + x
			newy = camera.y + y
			
			'Check if the x and y values are within the array boundaries.
			if newx >= 0 and newx <= gset.world_size.x then
				if newy >= 0 and newy <= gset.world_size.y then
					
					tile_map(x, y).tile_start.x = x * gset.tile_size
					tile_map(x, y).tile_start.y = y * gset.tile_size
					tile_map(x, y).tile_end.x = x * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_end.y = y * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_index = map(newx, newy).tile_type

					draw_tile tile_map(x, y)
					if checkInBounds(newx, newy) = 1 then
						if map(newx, newy).spawn_entity <> 0 then
							line (tile_map(x, y).tile_start.x, tile_map(x, y).tile_start.y)-(tile_map(x, y).tile_end.x, tile_map(x, y).tile_end.y), _rgba(0, 0, 0, 127), bf
							color _rgba(0, 0, 0, 127)
							_printstring (tile_map(x, y).tile_start.x + 1, tile_map(x, y).tile_start.y + 1), str$(map(newx, newy).entity_id)
							color _rgba(255, 0, 0, 255)
							_printstring (tile_map(x, y).tile_start.x + 1, tile_map(x, y).tile_start.y + 1), str$(map(newx, newy).entity_id)
						end if
					end if
				end if
			end if
			
		next x
	next y
	for y = 0 to 14
		for x = 0 to 19
			newx = camera.x + x
			newy = camera.y + y
			
			'Check if the x and y values are within the array boundaries.
			if newx >= 0 and newx <= gset.world_size.x then
				if newy >= 0 and newy <= gset.world_size.y then
					
					tile_map(x, y).tile_start.x = x * gset.tile_size
					tile_map(x, y).tile_start.y = y * gset.tile_size
					tile_map(x, y).tile_end.x = x * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_end.y = y * gset.tile_size + gset.tile_size
					tile_map(x, y).tile_index = map(newx, newy).tile_type

					if cx = x and cy = y and checkInBounds(newx, newy) = 1 then
						if ebrush.spawn_entity = 0 then
							line (tile_map(x, y).tile_start.x, tile_map(x, y).tile_start.y)-(tile_map(x, y).tile_end.x, tile_map(x, y).tile_end.y), _rgba(255, 255, 255, 127), bf
						else
							line (tile_map(x, y).tile_start.x, tile_map(x, y).tile_start.y)-(tile_map(x, y).tile_end.x, tile_map(x, y).tile_end.y), _rgba(255, 255, 0, 127), bf
						end if
						
						
						datastring$ = "id:" + str$(map(newx, newy).tile_type) + " ei:" + str$(map(newx, newy).event_index_interact) + " ez:" + str$(map(newx, newy).event_index_zone)
						color _rgba(0, 0, 0, 127)
						_printstring (tile_map(x, y).tile_end.x + 3, tile_map(x, y).tile_start.y + 1), datastring$
						color _rgba(255, 255, 255, 255)
						_printstring (tile_map(x, y).tile_end.x + 2, tile_map(x, y).tile_start.y), datastring$
						
						
						datastring$ = "A:" + str$(map(newx, newy).var_A) + " B:" + str$(map(newx, newy).var_B) + " C:" + str$(map(newx, newy).var_C)
						color _rgba(0, 0, 0, 127)
						_printstring (tile_map(x, y).tile_end.x + 3, tile_map(x, y).tile_start.y + 17), datastring$
						color _rgba(255, 255, 255, 255)
						_printstring (tile_map(x, y).tile_end.x + 2, tile_map(x, y).tile_start.y + 16), datastring$
						
						datastring$ = "se:" + str$(map(newx, newy).spawn_entity) + " eid:" + str$(map(newx, newy).entity_id) + " eq:" + str$(map(newx, newy).entity_quantity) + " drs:" + str$(map(newx, newy).dont_repeat_spawning) + " esp:" + str$(map(newx, newy).entity_spawned)
						color _rgba(0, 0, 0, 127)
						_printstring (tile_map(x, y).tile_end.x + 3, tile_map(x, y).tile_start.y + 33), datastring$
						color _rgba(255, 255, 255, 255)
						_printstring (tile_map(x, y).tile_end.x + 2, tile_map(x, y).tile_start.y + 32), datastring$
					end if
					
				end if
			end if
		next x
	next y
	color _rgba(255, 255, 255, 255)
	
	dim selected_tile as screen_tile
	selected_tile.tile_start.x = 8
	selected_tile.tile_start.y = 600 - 48
	selected_tile.tile_end.x = 40
	selected_tile.tile_end.y = 600 - 16
	selected_tile.tile_index = ebrush.tile_type
	draw_tile selected_tile
end sub
