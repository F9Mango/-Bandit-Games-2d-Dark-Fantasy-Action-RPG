sub create_entity(id as integer, spawner as string * 4, x as double, y as double, drop as _unsigned _byte, drop_id as _unsigned integer)
	i = 0
	print #1, ">>>order recieved to create entity with an id of"; id
	
	if spawner = "grid" then
		existing = 0
		for i = 0 to 128
			if entities(i).state = 1 and entities(i).grid_home.x = x and entities(i).grid_home.y = y then existing = existing + 1
		next i
	end if
	
	for i = 0 to 128
		if entities(i).state = 0 then
			print #1, "   unused location in entity array found at"; i; "-- creating entity..."
			entities(i) = blank_entity
			entities(i).id = id
			gset.numberOfEntities = gset.numberOfEntities + 1
			entities(i).state = 1
			if spawner = "grid" then
				if existing = 0 then
					entities(i).persistent = 1
					entities(i).grid_home.x = x
					entities(i).grid_home.y = y
					entities(i).p.x = x * 32
					entities(i).p.y = y * 32
				end if
			else
				entities(i).p.x = x
				entities(i).p.y = y
			end if
			
			'if drop <> 0 then
			'	entities(i).drop_entity = 1
			'	entities(i).drop_entity_id = drop_id
			'end if
			
			entities(i).home = entities(i).p
			
				select case id
					case 0: 'key
						'entities(i).w = int(rnd * 64)
						'entities(i).h = int(rnd * 64)
						entities(i).persistent = 1
						entities(i).w = 16
						entities(i).h = 16
						entities(i).wm = 1
						entities(i).hm = 1
						'entities(i).look.r = int(rnd * 256)
						'entities(i).look.g = int(rnd * 256)
						'entities(i).look.b = int(rnd * 256)
						entities(i).is_image = 1
						entities(i).index_start = 0
						entities(i).index_end = 0
					case 1: 'bat
						'entities(i).w = int(rnd * 64)
						'entities(i).h = int(rnd * 64)
						entities(i).w = 32
						entities(i).h = 32
						entities(i).o.x = -(entities(i).w / 2)
						entities(i).o.y = -(entities(i).h / 2)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).isFlying = 1
						'entities(i).look.r = int(rnd * 256)
						'entities(i).look.g = int(rnd * 256)
						'entities(i).look.b = int(rnd * 256)
						entities(i).layer = 1
						entities(i).is_image = 1
						entities(i).index_start = 1
						entities(i).index_end = 1
						entities(i).var_H = 1
						entities(i).drop_entity = 1
						entities(i).drop_entity_id = 7
					case 2: 'husk
						'entities(i).w = int(rnd * 64)
						'entities(i).h = int(rnd * 64)
						entities(i).w = 16
						entities(i).h = 24
						entities(i).o.x = -(entities(i).w / 2)
						entities(i).o.y = -(entities(i).h / 1)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).look.r = 0
						entities(i).look.g = 64
						entities(i).look.b = 0
						'entities(i).is_image = 1
						'entities(i).index_start = 1
						'entities(i).index_end = 1
						entities(i).var_H = 4
						entities(i).drop_entity = 1
						entities(i).drop_entity_id = 7
					case 3: 'food
						'entities(i).w = int(rnd * 64)
						'entities(i).h = int(rnd * 64)
						entities(i).w = 16
						entities(i).h = 16
						entities(i).wm = 1
						entities(i).hm = 1
						'entities(i).look.r = int(rnd * 256)
						'entities(i).look.g = int(rnd * 256)
						'entities(i).look.b = int(rnd * 256)
						entities(i).is_image = 1
						entities(i).index_start = 2
						entities(i).index_end = 2
					case 4: 'sword lvl 1
						'entities(i).w = int(rnd * 64)
						'entities(i).h = int(rnd * 64)
						entities(i).w = 16
						entities(i).h = 16
						entities(i).wm = 1
						entities(i).hm = 1
						'entities(i).look.r = int(rnd * 256)
						'entities(i).look.g = int(rnd * 256)
						'entities(i).look.b = int(rnd * 256)
						entities(i).is_image = 1
						entities(i).index_start = 3
						entities(i).index_end = 3
						entities(i).var_A = 1
					case 5: 'old man NPC
						entities(i).persistent = 1
						entities(i).w = 24
						entities(i).h = 24
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).is_image = 1
						entities(i).index_start = 4
						entities(i).index_end = 4
						entities(i).can_chat = 1
						entities(i).chat = 0
					case 7: 'coin
						entities(i).persistent = 0
						entities(i).w = 16
						entities(i).h = 16
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).is_image = 1
						entities(i).index_start = 5
						entities(i).index_end = 5
					case 8: 'sword lvl 2
						'entities(i).w = int(rnd * 64)
						'entities(i).h = int(rnd * 64)
						entities(i).w = 16
						entities(i).h = 16
						entities(i).wm = 1
						entities(i).hm = 1
						'entities(i).look.r = int(rnd * 256)
						'entities(i).look.g = int(rnd * 256)
						'entities(i).look.b = int(rnd * 256)
						entities(i).is_image = 1
						entities(i).index_start = 3
						entities(i).index_end = 3
						entities(i).var_A = 2
					case 9: 'Moon god
						entities(i).w = 128
						entities(i).h = 128
						entities(i).o.x = -(entities(i).w / 2)
						entities(i).o.y = -(entities(i).h / 2)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).look.r = 200
						entities(i).look.g = 200
						entities(i).look.b = 200
						'entities(i).is_image = 1
						'entities(i).index_start = 1
						'entities(i).index_end = 1
						entities(i).var_A = 32
						entities(i).var_H = 20
						entities(i).drop_entity = 1
						entities(i).drop_entity_id = 12
					case 10: 'Sun god
						entities(i).w = 128
						entities(i).h = 128
						entities(i).o.x = -(entities(i).w / 2)
						entities(i).o.y = -(entities(i).h / 2)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).look.r = 200
						entities(i).look.g = 200
						entities(i).look.b = 100
						'entities(i).is_image = 1
						'entities(i).index_start = 1
						'entities(i).index_end = 1
						entities(i).var_A = 32
						entities(i).var_H = 40
						entities(i).drop_entity = 1
						entities(i).drop_entity_id = 13
					case 11: 'fireball
						entities(i).w = 16
						entities(i).h = 16
						entities(i).o.x = -(entities(i).w / 2)
						entities(i).o.y = -(entities(i).h / 2)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).look.r = 200
						entities(i).look.g = 100
						entities(i).look.b = 0
						entities(i).direction.x = rnd - 0.5
						entities(i).direction.y = rnd - 0.5
						entities(i).isFlying = 1
						entities(i).var_A = 512
					case 12: 'moon pearl
						entities(i).w = 16
						entities(i).h = 16
						entities(i).o.x = -(entities(i).w / 2)
						entities(i).o.y = -(entities(i).h / 2)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).look.r = 200
						entities(i).look.g = 200
						entities(i).look.b = 250
						entities(i).isFlying = 1
					case 13: 'sun pearl
						entities(i).w = 16
						entities(i).h = 16
						entities(i).o.x = -(entities(i).w / 2)
						entities(i).o.y = -(entities(i).h / 2)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).look.r = 200
						entities(i).look.g = 200
						entities(i).look.b = 0
						entities(i).isFlying = 1
					case else:
						entities(i).w = int(rnd * 64)
						entities(i).h = int(rnd * 64)
						entities(i).wm = 1
						entities(i).hm = 1
						entities(i).look.r = int(rnd * 256)
						entities(i).look.g = int(rnd * 256)
						entities(i).look.b = int(rnd * 256)
				end select
				
						print #1, "   created entity "; i; " at "; entities(i).p.x;"x";entities(i).p.y; " with an id of "; entities(i).id; " and a state of "; entities(i).state
				
			exit for
		else
			if i = 128 then
				print #1, "   ***Entity buffer full! Cannot generate any more!***"
			end if
		end if
	next i
	update_ui
end sub

sub destroy_entity(e as _unsigned _byte, reason as _unsigned _byte)
	print #1, ">>>destroyed entity "; e; " at "; entities(e).p.x;"x";entities(e).p.y; " with an id of "; entities(e).id; " and a state of "; entities(e).state
	
	if reason = 0 then 'If the entity is destroyed for normal reasons.
		if entities(e).drop_entity = 1 then
			create_entity entities(e).drop_entity_id, "free", entities(e).p.x, entities(e).p.y, 0, 0
		'	create_entity 7, "free", entities(e).p.x, entities(e).p.y, 0, 0
		end if
		
		if entities(e).grid_home.x <> 0 and entities(e).grid_home.y <> 0 then
			if map(entities(e).grid_home.x, entities(e).grid_home.y).spawn_entity = 1 and map(entities(e).grid_home.x, entities(e).grid_home.y).entity_id = entities(e).id then
				if map(entities(e).grid_home.x, entities(e).grid_home.y).dont_repeat_spawning = 0 then
					if map(entities(e).grid_home.x, entities(e).grid_home.y).entity_quantity = 1 then
						print #1, "   Setting entity_spawned to 0 at"; entities(e).grid_home.x;"x";entities(e).grid_home.y
						map(entities(e).grid_home.x, entities(e).grid_home.y).entity_spawned = 0
					end if
					if map(entities(e).grid_home.x, entities(e).grid_home.y).entity_quantity > 1 then
						print #1, "   Setting entity_spawned to 0 at"; entities(e).grid_home.x;"x";entities(e).grid_home.y
						map(entities(e).grid_home.x, entities(e).grid_home.y).entity_spawned = 0
					end if
				end if
			end if
		end if
	end if
	if reason = 1 then 'If the entity is destroyed for abnormal reasons, such as exceeding max distance, requiring it to be respawned when the player returns.
		print #1, "   Setting entity_spawned to 0 at"; entities(e).grid_home.x;"x";entities(e).grid_home.y
		map(entities(e).grid_home.x, entities(e).grid_home.y).entity_spawned = 0
	end if
	
	entities(e) = blank_entity
	entities(e).state = 0
	print #1, "   entity"; e; "state post-deletion:"; entities(e).state
	
	print #1, "   reducing entity count by 1"
	gset.numberOfEntities = gset.numberOfEntities - 1
	print #1, "   Entity count now at"; gset.numberOfEntities
	update_ui
end sub

sub sort_entities
	print #1, "!!!Sorting entities"
	for i = 1 to 128
		for j = i to 128
			if entities(i).state <> 0 then
				e_sorting_buffer(i).state = entities(j).state
				e_sorting_buffer(i).id = entities(j).id
				e_sorting_buffer(i).home.x = entities(j).home.x
				e_sorting_buffer(i).home.y = entities(j).home.y
				e_sorting_buffer(i).p.x = entities(j).p.x
				e_sorting_buffer(i).p.y = entities(j).p.y
				e_sorting_buffer(i).v.x = entities(j).v.x
				e_sorting_buffer(i).v.y = entities(j).v.y
				e_sorting_buffer(i).w = entities(j).w
				e_sorting_buffer(i).h = entities(j).h
				e_sorting_buffer(i).o.x = entities(j).o.x
				e_sorting_buffer(i).o.y = entities(j).o.y
				e_sorting_buffer(i).tl.x = entities(j).tl.x
				e_sorting_buffer(i).tl.y = entities(j).tl.y
				e_sorting_buffer(i).tr.x = entities(j).tr.x
				e_sorting_buffer(i).tr.y = entities(j).tr.y
				e_sorting_buffer(i).bl.x = entities(j).bl.x
				e_sorting_buffer(i).bl.y = entities(j).bl.y
				e_sorting_buffer(i).br.x = entities(j).br.x
				e_sorting_buffer(i).br.y = entities(j).br.y
				e_sorting_buffer(i).wm = entities(j).wm
				e_sorting_buffer(i).hm = entities(j).hm
				e_sorting_buffer(i).gravity = entities(j).gravity
				e_sorting_buffer(i).onGround = entities(j).onGround
				e_sorting_buffer(i).is_image = entities(j).is_image
				e_sorting_buffer(i).index_start = entities(j).index_start
				e_sorting_buffer(i).index_end = entities(j).index_end
				e_sorting_buffer(i).frame_counter = entities(j).frame_counter
				e_sorting_buffer(i).frame_threshold = entities(j).frame_threshold
				e_sorting_buffer(i).frame_step = entities(j).frame_step
				e_sorting_buffer(i).is_looping = entities(j).is_looping
				e_sorting_buffer(i).look.r = entities(j).look.r
				e_sorting_buffer(i).look.g = entities(j).look.g
				e_sorting_buffer(i).look.b = entities(j).look.b
				e_sorting_buffer(i).direction.x = entities(j).direction.x
				e_sorting_buffer(i).direction.y = entities(j).direction.y
				e_sorting_buffer(i).actionPoint_default.x = entities(j).actionPoint_default.x
				e_sorting_buffer(i).actionPoint_default.y = entities(j).actionPoint_default.y
				e_sorting_buffer(i).actionPoint.x = entities(j).actionPoint.x
				e_sorting_buffer(i).actionPoint.y = entities(j).actionPoint.y
				e_sorting_buffer(i).var_A = entities(j).var_A
				e_sorting_buffer(i).var_B = entities(j).var_B
				e_sorting_buffer(i).var_C = entities(j).var_C
				e_sorting_buffer(i).var_D = entities(j).var_D
				e_sorting_buffer(i).var_E = entities(j).var_E
				e_sorting_buffer(i).var_F = entities(j).var_F
				e_sorting_buffer(i).var_G = entities(j).var_G
				e_sorting_buffer(i).var_H = entities(j).var_H
				exit for
			end if
		next j
	next i
	for i = 1 to 128
		entities(i).state = e_sorting_buffer(i).state
		entities(i).id = e_sorting_buffer(i).id
		entities(i).home.x = e_sorting_buffer(i).home.x
		entities(i).home.y = e_sorting_buffer(i).home.y
		entities(i).p.x = e_sorting_buffer(i).p.x
		entities(i).p.y = e_sorting_buffer(i).p.y
		entities(i).v.x = e_sorting_buffer(i).v.x
		entities(i).v.y = e_sorting_buffer(i).v.y
		entities(i).w = e_sorting_buffer(i).w
		entities(i).h = e_sorting_buffer(i).h
		entities(i).o.x = e_sorting_buffer(i).o.x
		entities(i).o.y = e_sorting_buffer(i).o.y
		entities(i).tl.x = e_sorting_buffer(i).tl.x
		entities(i).tl.y = e_sorting_buffer(i).tl.y
		entities(i).tr.x = e_sorting_buffer(i).tr.x
		entities(i).tr.y = e_sorting_buffer(i).tr.y
		entities(i).bl.x = e_sorting_buffer(i).bl.x
		entities(i).bl.y = e_sorting_buffer(i).bl.y
		entities(i).br.x = e_sorting_buffer(i).br.x
		entities(i).br.y = e_sorting_buffer(i).br.y
		entities(i).wm = e_sorting_buffer(i).wm
		entities(i).hm = e_sorting_buffer(i).hm
		entities(i).gravity = e_sorting_buffer(i).gravity
		entities(i).onGround = e_sorting_buffer(i).onGround
		entities(i).is_image = e_sorting_buffer(i).is_image
		entities(i).index_start = e_sorting_buffer(i).index_start
		entities(i).index_end = e_sorting_buffer(i).index_end
		entities(i).frame_counter = e_sorting_buffer(i).frame_counter
		entities(i).frame_threshold = e_sorting_buffer(i).frame_threshold
		entities(i).frame_step = e_sorting_buffer(i).frame_step
		entities(i).is_looping = e_sorting_buffer(i).is_looping
		entities(i).look.r = e_sorting_buffer(i).look.r
		entities(i).look.g = e_sorting_buffer(i).look.g
		entities(i).look.b = e_sorting_buffer(i).look.b
		entities(i).direction.x = e_sorting_buffer(i).direction.x
		entities(i).direction.y = e_sorting_buffer(i).direction.y
		entities(i).actionPoint_default.x = e_sorting_buffer(i).actionPoint_default.x
		entities(i).actionPoint_default.y = e_sorting_buffer(i).actionPoint_default.y
		entities(i).actionPoint.x = e_sorting_buffer(i).actionPoint.x
		entities(i).actionPoint.y = e_sorting_buffer(i).actionPoint.y
		entities(i).var_A = e_sorting_buffer(i).var_A
		entities(i).var_B = e_sorting_buffer(i).var_B
		entities(i).var_C = e_sorting_buffer(i).var_C
		entities(i).var_D = e_sorting_buffer(i).var_D
		entities(i).var_E = e_sorting_buffer(i).var_E
		entities(i).var_F = e_sorting_buffer(i).var_F
		entities(i).var_G = e_sorting_buffer(i).var_G
		entities(i).var_H = e_sorting_buffer(i).var_H
	next i
end sub

sub entity_ai(e as _unsigned _byte)
	select case entities(e).id
	
		case 1: 'temp id for bats
			
			'locate the center of the player
			px = entities(0).tl.x + entities(0).w / 2
			py = entities(0).tl.y + entities(0).h / 2
			
			xdiff = px - entities(e).p.x 'finds the horizontal distance between the player and the bat
			ydiff = py - entities(e).p.y 'finds the vertical distance between the player and the bat
			
			randomize timer 'prime the random number generator using system time as a seed.
			'find the directional vectors by dividing the difference variables by their absolute values to produce coefficients of 1, -1, or 0.
			'Then multiply them by a speed-limiting value and a random number to produce erratic motion.
			xdir = (xdiff / abs(xdiff)) * 0.25 * rnd
			ydir = (ydiff / abs(ydiff)) * 0.25 * rnd
			
			if distance2d(entities(e).p, entities(0).p) < 128 then
				if entities(e).var_B = 0 then
					entities(e).v.x = xdir
					entities(e).v.y = ydir
					if entity_is_colliding(entities(e), entities(0)) = 1 then
						entities(e).var_B = 1
						entities(e).var_C = 300
					end if
				end if
				
				
			else
				if entities(e).p.x <> entities(e).home.x and entities(e).p.y <> entities(e).home.y then
					xdiff = entities(e).home.x - entities(e).p.x
					ydiff = entities(e).home.y - entities(e).p.y
					
					randomize timer
					xdir = (xdiff / abs(xdiff)) * 0.25 * rnd
					ydir = (ydiff / abs(ydiff)) * 0.25 * rnd
					'
					entities(e).v.x = xdir
					entities(e).v.y = ydir
				end if
				
				
			end if
			if entities(e).var_B = 1 then
				if entities(e).var_C > 0 then
					entities(e).v.x = -xdir 'entities(e).v.x + xdir
					entities(e).v.y = -ydir 'entities(e).v.y + ydir
					entities(e).var_C = entities(e).var_C - 1
				else
					entities(e).var_B = 0
					entities(e).var_C = 0
				end if
			end if
		
		
		case 2: 'temp id for zombies

			if distance2d(entities(e).p, entities(0).p) < 192 then
				entities(e).var_A = 1
			else
				entities(e).var_A = 0
			end if
		
			select case entities(e).var_A
				case 0: 'wandering
					if gset.isPlatformer = 0 then
						randomize timer
						random_value = int(rnd * 2048)
						if random_value <= 8 then entities(e).var_B = random_value
						
						select case entities(e).var_B
							case 1:
								entities(e).v.x = 0.05
								entities(e).v.y = 0
							case 2:
								entities(e).v.x = 0.05
								entities(e).v.y = 0.05
							case 3:
								entities(e).v.x = 0
								entities(e).v.y = 0.05
							case 4:
								entities(e).v.x = -0.05
								entities(e).v.y = 0.05
							case 5:
								entities(e).v.x = -0.05
								entities(e).v.y = 0
							case 6:
								entities(e).v.x = -0.05
								entities(e).v.y = -0.05
							case 7:
								entities(e).v.x = 0
								entities(e).v.y = -0.05
							case 8:
								entities(e).v.x = 0.05
								entities(e).v.y = -0.05
						end select
					else
						if entities(e).onGround = 1 then
							randomize timer
							random_value = int(rnd * 2048)
							if random_value <= 3 then entities(e).var_B = random_value
							if random_value >= 4 and random_value <= 14 then entities(e).v.y = entities(e).v.y - (10 + int(rnd * 10))
							
							select case entities(e).var_B
								case 1:
									entities(e).v.x = entities(e).v.x + 0.005
								case 2:
									entities(e).v.x = entities(e).v.x - 0.005
								case 3:
									entities(e).v.x = 0
							end select
						end if
					end if
					
				case 1: 'attacking
					if gset.isPlatformer = 0 then
						'locate the center of the player
						'px = entities(0).tl.x + entities(0).w / 2
						'py = entities(0).tl.y + entities(0).h / 2
						
						xdiff = entities(0).p.x - entities(e).p.x 'finds the horizontal distance between the player and the enemy
						ydiff = entities(0).p.y - entities(e).p.y 'finds the vertical distance between the player and the enemy
						
						randomize timer 'prime the random number generator using system time as a seed.
						'find the directional vectors by dividing the difference variables by their absolute values to produce coefficients of 1, -1, or 0.
						'Then multiply them by a speed-limiting value and a random number to produce erratic motion.
						xdir = (xdiff / abs(xdiff)) * 0.1
						ydir = (ydiff / abs(ydiff)) * 0.1
						
						entities(e).v.x = xdir
						entities(e).v.y = ydir
						if entity_is_colliding(entities(0), entities(e)) = 1 then
							entities(e).v.x = 0
							entities(e).v.y = 0
						end if
					else
						xdiff = entities(0).p.x - entities(e).p.x 'finds the horizontal distance between the player and the enemy
						randomize timer 'prime the random number generator using system time as a seed.
						random_value = int(rnd * 2048)
						if entities(e).onGround = 1 then
							if random_value >= 4 and random_value <= 14 then
								entities(e).v.y = entities(e).v.y - (10 + int(rnd * 10))
								entities(e).knock_v.y = entities(e).knock_v.y - 1
							end if
							xdir = (xdiff / abs(xdiff)) * 0.01
						else
							xdir = 0 '(xdiff / abs(xdiff)) * 0.001
						end if
						entities(e).v.x = entities(e).v.x + xdir
					end if
				
			end select
		
		case 9 to 10: 'moon and sun gods
			'print #1, "Sun god cooldown!"; entities(e).var_A
			if entities(e).var_A > 0 then entities(e).var_A = entities(e).var_A - 1
			if entities(e).var_A <= 0 then
				'for i = 0 to 10
					create_entity 11, "free", entities(e).p.x, entities(e).p.y, 0, 0
				'next i
				entities(e).var_A = 32
			end if
		case 11: 'fireball
			entities(e).v = entities(e).direction
			if isColWMap(entities(e).p.x, entities(e).p.y) = 1 or entities(e).var_A <= 0 then destroy_entity e, 0
			entities(e).var_A = entities(e).var_A - 1
	end select
	
end sub

function entity_is_colliding (a as entity, b as entity)
	if a.state <> 0 and b.state <> 0 then
		'Initializing the values for entity A's corner collisions.
		'Top left xy
		a.tl.x = a.p.x + (a.o.x * a.wm)
		a.tl.y = a.p.y + (a.o.y * a.hm)
		'Top right xy
		a.tr.x = a.p.x + ((a.o.x + a.w) * a.wm)
		a.tr.y = a.p.y + (a.o.y * a.hm)
		'Bottom left xy
		a.bl.x = a.p.x + (a.o.x * a.wm)
		a.bl.y = a.p.y + ((a.o.y + a.h) * a.hm)
		'Bottom right xy
		a.br.x = a.p.x + ((a.o.x + a.w) * a.wm)
		a.br.y = a.p.y + ((a.o.y + a.h) * a.hm)
		
		'Initializing the values for entity B's corner collisions.
		'Top left xy
		x1 = b.p.x + (b.o.x * b.wm)
		y1 = b.p.y + (b.o.y * b.hm)

		'Bottom right xy
		x2 = b.p.x + ((b.o.x + b.w) * b.wm)
		y2 = b.p.y + ((b.o.y + b.h) * b.hm)
		
		if a.tl.x >= x1 and a.tl.x <= x2 then
			if a.tl.y >= y1 and a.tl.y <= y2 then
				collision_a = 1
			end if
		end if
		if a.tr.x >= x1 and a.tr.x <= x2 then
			if a.tr.y >= y1 and a.tr.y <= y2 then
				collision_a = 1
			end if
		end if
		if a.bl.x >= x1 and a.bl.x <= x2 then
			if a.bl.y >= y1 and a.bl.y <= y2 then
				collision_a = 1
			end if
		end if
		if a.br.x >= x1 and a.br.x <= x2 then
			if a.br.y >= y1 and a.br.y <= y2 then
				collision_a = 1
			end if
		end if
		
		
		'Initializing the values for entity B's corner collisions.
		'Top left xy
		b.tl.x = b.p.x + (b.o.x * b.wm)
		b.tl.y = b.p.y + (b.o.y * b.hm)
		'Top right xy
		b.tr.x = b.p.x + ((b.o.x + b.w) * b.wm)
		b.tr.y = b.p.y + (b.o.y * b.hm)
		'Bottom left xy
		b.bl.x = b.p.x + (b.o.x * b.wm)
		b.bl.y = b.p.y + ((b.o.y + b.h) * b.hm)
		'Bottom right xy
		b.br.x = b.p.x + ((b.o.x + b.w) * b.wm)
		b.br.y = b.p.y + ((b.o.y + b.h) * b.hm)
		
		'Initializing the values for entity A's corner collisions.
		'Top left xy
		x1 = a.p.x + (a.o.x * a.wm)
		y1 = a.p.y + (a.o.y * a.hm)

		'Bottom right xy
		x2 = a.p.x + ((a.o.x + a.w) * a.wm)
		y2 = a.p.y + ((a.o.y + a.h) * a.hm)
		
		if b.tl.x >= x1 and b.tl.x <= x2 then
			if b.tl.y >= y1 and b.tl.y <= y2 then
				collision_b = 1
			end if
		end if
		if b.tr.x >= x1 and b.tr.x <= x2 then
			if b.tr.y >= y1 and b.tr.y <= y2 then
				collision_b = 1
			end if
		end if
		if b.bl.x >= x1 and b.bl.x <= x2 then
			if b.bl.y >= y1 and b.bl.y <= y2 then
				collision_b = 1
			end if
		end if
		if b.br.x >= x1 and b.br.x <= x2 then
			if b.br.y >= y1 and b.br.y <= y2 then
				collision_b = 1
			end if
		end if
		
		if collision_a = 1 or collision_b = 1 then
			entity_is_colliding = 1
		end if
		
	end if
end function

function entity_test_zone (a as entity, x1 as double, y1 as double, x2 as double, y2 as double)
	if a.state <> 0 then
		'Initializing the values for entity A's corner collisions.
		'Top left xy
		a.tl.x = a.p.x + (a.o.x * a.wm)
		a.tl.y = a.p.y + (a.o.y * a.hm)
		'Top right xy
		a.tr.x = a.p.x + ((a.o.x + a.w) * a.wm)
		a.tr.y = a.p.y + (a.o.y * a.hm)
		'Bottom left xy
		a.bl.x = a.p.x + (a.o.x * a.wm)
		a.bl.y = a.p.y + ((a.o.y + a.h) * a.hm)
		'Bottom right xy
		a.br.x = a.p.x + ((a.o.x + a.w) * a.wm)
		a.br.y = a.p.y + ((a.o.y + a.h) * a.hm)
		
		for y = y1 to y2
			for x = x1 to x2
			
			
				if x >= a.tl.x and x <= a.br.x then
					if y >= a.tl.y and y <= a.br.y then
						collision_a = 1
					end if
				end if
				
				
			next x
		next y
		
		if collision_a = 1 then entity_test_zone = 1
		
	end if
end function

function is_on_screen(e as entity)
	i = 0
	if e.home.x >= camera.x and e.home.x <= camera.x + 20 then
		if e.home.y >= camera.y and e.home.y <= camera.y + 15 then
			i = 1
		end if
	end if
	is_on_screen = i
end function
