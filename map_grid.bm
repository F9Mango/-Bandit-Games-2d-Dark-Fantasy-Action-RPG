sub load_map(mapName as string * 50)
	dim clr as _unsigned long
	name$ = _trim$(mapName)
	mapImg = _loadimage(name$, 32)
	_source mapImg
	w = _width(mapImg)
	h = _height(mapImg)
	gset.world_size.x = w
	gset.world_size.y = h
	redim map(gset.world_size.x, gset.world_size.y) as map_tile
	open "log.txt" for output as #1
	for y = 0 to w
		for x = 0 to h
			clr = point(x, y)
			r = _red32(clr)
			g = _green32(clr)
			b = _blue32(clr)
			print #1, x, y, r, g, b
			if r = 0   and g = 0   and b = 0   then map(x, y).tile_type = 0
			if r = 255 and g = 0   and b = 0   then map(x, y).tile_type = 1
			if r = 255 and g = 255 and b = 0   then map(x, y).tile_type = 2
			if r = 0   and g = 255 and b = 0   then map(x, y).tile_type = 4
			if r = 0   and g = 255 and b = 255 then map(x, y).tile_type = 6
			if r = 0   and g = 0   and b = 255 then map(x, y).tile_type = 8
			
			'if r = 255 and g = 255 and b = 255 then map(x, y).tile_type = 128
			
			if map_tileset(map(x, y).tile_type).class = 1 then
				randomize timer
				map(x, y).var_C = int(rnd * 4294967296)
			end if
			
			select case map(x, y).tile_type
				case 2:
					if map(x, y - 1).tile_type = 4 then map(x, y - 1).var_C = map(x, y).var_C
				case 6:
					if map(x - 1, y).tile_type = 8 then map(x - 1, y).var_C = map(x, y).var_C
			end select
			
		next x
	next y
	close #1
end sub

sub generate_map
	for y = 0 to gset.world_size.y
		for x = 0 to gset.world_size.x
			randomize (timer + x + y)
			select case int(rnd * 20)
				case 0 to 2:
					map(x, y).tile_type = 1
				case 3:
					map(x, y).tile_type = 2
				case 4:
					map(x, y).tile_type = 4
				case 5:
					map(x, y).tile_type = 6
				case 6:
					map(x, y).tile_type = 8
				case else:
					map(x, y).tile_type = 0
			end select
		next x
	next y
end sub

function localToGrid(a as double)
	localToGrid = int(a / 32)
end function

function checkInBounds (x as double, y as double)
	a = 0
	'Check if coordinates are within world boundary.
	if x >= 0 and x <= gset.world_size.x then
		if y >= 0 and y <= gset.world_size.y then
			'Affirm that we are inside the boundary.
			a = 1
		end if
	end if
	checkInBounds = a
end function

function isColWMap(x1 as double, y1 as double)
	'Scale and truncate entity-coordinates to match the tile grid.
	x = int(x1 / 32)
	y = int(y1 / 32)
	
	if checkInBounds(x, y) = 1 then
		'If we're inside the boundary, compare against the world map grid.
		if map_tileset(map(x, y).tile_type).has_collision <> 0 then
			isColWMap = 1
		else
			isColWMap = 0
		end if
	else
		isColWMap = 0
	end if
end function
